FROM python:3.11-slim

COPY devops/app/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./

# single worker: Dash registers component resources per worker at first index
# render, so multiple workers race on cold start; heavy callbacks run in
# separate processes via the diskcache background-callback manager anyway
CMD [ "gunicorn", "--workers=1", "--threads=12", "-b", "0.0.0.0:80", "--timeout", "0", "app:server"]
