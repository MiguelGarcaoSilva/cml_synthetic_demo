FROM python:3.11-slim

COPY devops/populate_db/requirements.txt ./

RUN apt-get update \
    && apt-get -y install --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir -r requirements.txt

COPY devops/populate_db/populate_synthetic.py  ./
COPY devops/populate_db/views_synthetic.sql  ./

CMD python ./populate_synthetic.py && psql -h $PG_HOST -p $PG_PORT -U $PG_USER -d $PG_DBNAME -f views_synthetic.sql
